{
  "name": "openwebtts",
  "version": "1.0.0",
  "private": true,
  "description": "A free, open-source text-to-speech web reader for Firefox (Android-first) and Chrome.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "extension dev",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "vp check --no-error-on-unmatched-pattern",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "postinstall": "node scripts/vendor-deps.mjs",
    "vendor": "node scripts/vendor-deps.mjs"
  },
  "dependencies": {
    "svelte": "^5.15.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.28.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "5.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint-import-resolver-oxc": "^0.15.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "esm-env": "1.2.2",
    "extension": "^4.0.30",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "runed": "0.35.1",
    "sentencex": "^1.0.30",
    "shadcn-svelte": "^1.5.0",
    "svelte-toolbelt": "0.10.6",
    "tabbable": "6.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "volta": {
    "node": "22.23.2"
  },
  "packageManager": "pnpm@11.20.0"
}
